{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": [
      "@dcloudio/types",
      "@mini-types/alipay",
      "miniprogram-api-typings",
      "@uni-helper/uni-types",
      "@wot-ui/ui/global",
      "uni-echarts/global"
    ],
    // game24 等 node --experimental-strip-types 单测相对导入需 .ts 扩展名；
    // 配合 type-check 的 --noEmit（TS 要求 allowImportingTsExtensions 时 noEmit/emitDeclarationOnly）
    "allowImportingTsExtensions": true,
    "sourceMap": true
  },
  "vueCompilerOptions": {
    // 调整 Volar（Vue 语言服务工具）解析行为，用于为 uni-app 组件提供 TypeScript 类型
    "plugins": ["@uni-helper/uni-types/volar-plugin"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/uni_modules",
    "src/**/*.test.ts"
  ]
}
