{
    "swagger": "2.0",
    "info": {
        "description": "alexGo-cloud 后端 order 模块 API 文档（swaggo 生成，`make swagger` 刷新）。\nadmin 侧（/admin/**）统一 pkg/resp 信封 {code,msg,data}；app 契约侧为裸 JSON 无信封。",
        "title": "alexGo-cloud order API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/admin/order/orders": {
            "get": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "权限 order:order；无 page/size 入参，data 为订单数组（不顺手加分页）。租户隔离在 repo 层（user_id → system_users.tenant_id）。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "order-admin"
                ],
                "summary": "订单全量列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "权限 order:order；body 全字段平铺（user_id/product_id/amount 分/状态/订单号）。成功 data 为 null。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "order-admin"
                ],
                "summary": "创建订单",
                "parameters": [
                    {
                        "description": "订单信息",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/admin/order/orders/export": {
            "get": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "权限 order:order；当前租户全量订单 Excel（ID/订单号/用户/产品/金额分/状态/时间）。Content-Disposition 附件下载。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "order-admin"
                ],
                "summary": "导出全量订单 xlsx",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    }
                }
            }
        }
    },
    "securityDefinitions": {
        "Bearer": {
            "description": "admin 侧统一登录令牌，格式 `Bearer <token>`。",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        },
        "X-Session": {
            "description": "app 契约侧自鉴权会话令牌（登录接口签发）。",
            "type": "apiKey",
            "name": "X-Session",
            "in": "header"
        }
    },
    "x-tagGroups": [
        {
            "name": "后台管理",
            "tags": [
                "order-admin"
            ]
        }
    ]
}
