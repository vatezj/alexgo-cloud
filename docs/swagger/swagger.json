                    "application/json"
                ],
                "tags": [
                    "fishgame-admin"
                ],
                "summary": "新建运营覆盖",
                "parameters": [
                    {
                        "description": "运营覆盖",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/service.ConfigInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
