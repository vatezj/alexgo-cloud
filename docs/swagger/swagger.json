                    },
                    {
                        "type": "integer",
                        "example": 1760600000,
                        "description": "起（含）unix 秒",
                        "name": "start_t",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "example": 1761200000,
                        "description": "止（含）unix 秒",
                        "name": "end_t",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
